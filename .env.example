# Server-only Ollama configuration. Defaults work locally without .env.local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT_MS=120000
# CPU-only locally. Set -1 for automatic GPU offload on future AI hardware.
OLLAMA_NUM_GPU=0
OLLAMA_MAX_CONCURRENT=1
# Required for a non-loopback production endpoint behind an authenticated HTTPS proxy.
# OLLAMA_API_TOKEN=
# Public website origin used by the HTML build for SEO:
# SITE_URL=https://your-website.example

